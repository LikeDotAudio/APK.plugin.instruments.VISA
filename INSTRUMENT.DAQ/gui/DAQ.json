{
  "DAQ_Instrument": {
    "type": "OcaBin",
    "id": "50.100.10.1",
    "notes": "The DAQ class was declared in Instruments:VISA/manifest.json with 4 model(s) on disk and no panel beside them, so instruments/mod.rs printed \"no template for type 'DAQ'\" and a discovered one drew nothing at all. This is that panel.",
    "geometry": {
      "anchor": "NSEW"
    },
    "behavior": {
      "overflow_ns": "auto",
      "overflow_ew": "auto",
      "fluid_ew": true
    },
    "description": {
      "En": "Data acquisition / switch unit — ${model}",
      "Fr": "Data acquisition / switch unit — ${model}",
      "De": "Data acquisition / switch unit — ${model}",
      "Es": "Data acquisition / switch unit — ${model}"
    },
    "blocks": {
      "Identity": {
        "type": "OcaBlock",
        "description": {
          "En": "Identity",
          "Fr": "Identity",
          "De": "Identity",
          "Es": "Identity",
          "show_label": true
        },
        "layout_columns": 2,
        "layout": {
          "pady": 4,
          "sticky": "nsew"
        },
        "fields": {
          "model": {
            "type": "_TextInput",
            "label": {
              "En": "Model",
              "Fr": "Model",
              "De": "Model",
              "Es": "Model"
            },
            "value_default": "---",
            "device_state": "model",
            "read_only": true,
            "layout": {
              "width": "100%",
              "font": 13
            }
          },
          "manufacturer": {
            "type": "_TextInput",
            "label": {
              "En": "Manufacturer",
              "Fr": "Manufacturer",
              "De": "Manufacturer",
              "Es": "Manufacturer"
            },
            "value_default": "---",
            "device_state": "manufacturer",
            "read_only": true,
            "layout": {
              "width": "100%",
              "font": 13
            }
          },
          "serial": {
            "type": "_TextInput",
            "label": {
              "En": "Serial",
              "Fr": "Serial",
              "De": "Serial",
              "Es": "Serial"
            },
            "value_default": "---",
            "device_state": "serial",
            "read_only": true,
            "layout": {
              "width": "100%",
              "font": 13
            }
          },
          "firmware": {
            "type": "_TextInput",
            "label": {
              "En": "Firmware",
              "Fr": "Firmware",
              "De": "Firmware",
              "Es": "Firmware"
            },
            "value_default": "---",
            "device_state": "firmware",
            "read_only": true,
            "layout": {
              "width": "100%",
              "font": 13
            }
          }
        }
      },
      "Connection": {
        "type": "OcaBlock",
        "description": {
          "En": "Connection",
          "Fr": "Connection",
          "De": "Connection",
          "Es": "Connection",
          "show_label": true
        },
        "layout_columns": 2,
        "layout": {
          "pady": 4,
          "sticky": "nsew"
        },
        "fields": {
          "port": {
            "type": "_TextInput",
            "label": {
              "En": "Port",
              "Fr": "Port",
              "De": "Port",
              "Es": "Port"
            },
            "value_default": "---",
            "device_state": "port",
            "read_only": true,
            "layout": {
              "width": "100%",
              "font": 13
            }
          },
          "resource": {
            "type": "_TextInput",
            "label": {
              "En": "VISA resource",
              "Fr": "VISA resource",
              "De": "VISA resource",
              "Es": "VISA resource"
            },
            "value_default": "---",
