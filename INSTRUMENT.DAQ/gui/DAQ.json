          "connection_status": {
            "type": "_SmartLight",
            "label": {
              "En": "Reachable",
              "Fr": "Reachable",
              "De": "Reachable",
              "Es": "Reachable"
            },
            "value_default": "unknown",
            "device_state": "status",
            "notes": "A state, not a string: `status` is the one field here whose value has a colour, and contracts/tokens/state.json is what decides which. Every other field on this panel is a read-only _TextInput because a string is all it is.",
            "layout": {
              "width": "100%"
            }
          },
          "last_seen": {
            "type": "_TextInput",
            "label": {
              "En": "Last seen",
              "Fr": "Last seen",
              "De": "Last seen",
              "Es": "Last seen"
            },
            "value_default": "---",
            "device_state": "last_seen",
