{
  "model": "E5515C",
  "family": "TestSet",
  "set": {
    "Set_Ese": {
      "scpi": "*ESE <value>",
      "description": "Set Standard Event Status Enable",
      "subsystem": "Common",
      "args": [
        "value"
      ],
      "unverified": true
    },
    "Set_Sre": {
      "scpi": "*SRE <value>",
      "description": "Set Service Request Enable",
      "subsystem": "Common",
      "args": [
        "value"
      ],
      "unverified": true
    },
    "Set_Speech_Echo_State": {
      "scpi": "CALL:AUDio:SPEech:ECHO:STATe <value>",
      "scpi_fast": "CALL:AUD:SPE:ECHO:STAT <value>",
      "description": "Set speech loopback echo state",
      "subsystem": "CALL",
      "args": [
        "value"
      ],
      "unverified": true
    },
    "Set_Call_Band": {
      "scpi": "CALL:BAND <value>",
      "scpi_fast": "CALL:BAND <value>",
      "description": "Set cellular operating band",
      "subsystem": "CALL",
      "args": [
        "value"
      ],
      "unverified": true
    },
    "Set_Call_Channel": {
      "scpi": "CALL:CHANnel <value>",
      "scpi_fast": "CALL:CHAN <value>",
      "description": "Set cellular channel ARFCN",
      "subsystem": "CALL",
      "args": [
        "value"
      ],
      "unverified": true
    },
    "Set_Cell_Power": {
      "scpi": "CALL:POWer <value>",
      "scpi_fast": "CALL:POW <value>",
      "description": "Set RF cell power level in dBm",
      "subsystem": "CALL",
      "args": [
        "value"
      ],
      "unverified": true
    },
    "Set_Display_Update": {
      "scpi": "SYSTem:DISPlay:UPDate <value>",
      "scpi_fast": "SYST:DISP:UPD <value>",
      "description": "Set screen update / blanking state to maximize bus execution speed",
      "subsystem": "SYSTem",
      "args": [
        "value"
      ],
      "unverified": true
    }
  },
  "do": {
    "Clear_Status": {
      "scpi": "*CLS",
      "description": "Clear status registers and error queue",
      "subsystem": "Common",
      "unverified": true
    },
    "Reset": {
      "scpi": "*RST",
      "description": "Reset instrument to factory defaults",
      "subsystem": "Common",
      "unverified": true
    },
    "Wait_To_Continue": {
      "scpi": "*WAI",
      "description": "Wait for pending operations to complete",
      "subsystem": "Common",
      "unverified": true
    },
    "End_Call": {
      "scpi": "CALL:END",
      "description": "End active cellular call",
      "subsystem": "CALL",
      "unverified": true
    },
    "Connect_Call": {
      "scpi": "CALL:PCONnection",
      "scpi_fast": "CALL:PCON",
      "description": "Establish cellular call connection",
      "subsystem": "CALL",
      "unverified": true
    }
  },
  "rig": {
    "Configure_Audio_Loopback": {
      "scpi": ":CALL:AUDio:SPEech:ECHO:STATe <state>;:CALL:AUDio:SPEech:ECHO:DELay <delay>",
      "description": "Configure speech echo loopback and delay",
      "subsystem": "CALL",
      "args": [
        "state",
        "delay"
      ],
      "unverified": true
    },
    "Configure_Cell": {
      "scpi": ":CALL:BAND <band>;:CALL:CHANnel <channel>;:CALL:POWer <power>",
      "description": "Configure cell band, channel, and RF power together",
      "subsystem": "CALL",
      "args": [
        "band",
        "channel",
        "power"
      ],
      "unverified": true
    }
  },
  "nab": {
    "Get_Idn": {
      "scpi": "*IDN?",
      "description": "Identification query",
      "subsystem": "Common",
      "returns": {
        "count": 1,
        "type": "CRD"
      },
      "unverified": true
    },
    "Get_Opc": {
      "scpi": "*OPC?",
      "description": "Operation complete query",
      "subsystem": "Common",
      "returns": {
        "count": 1,
        "type": "BOOL"
      },
      "unverified": true
    },
    "Get_Status_Byte": {
      "scpi": "*STB?",
      "description": "Read status byte query",
      "subsystem": "Common",
      "returns": {
        "count": 1,
        "type": "NR1"
      },
      "unverified": true
    },
    "Get_Speech_Echo_State": {
      "scpi": "CALL:AUDio:SPEech:ECHO:STATe?",
      "scpi_fast": "CALL:AUD:SPE:ECHO:STAT?",
      "description": "Query speech loopback echo state",
      "subsystem": "CALL",
