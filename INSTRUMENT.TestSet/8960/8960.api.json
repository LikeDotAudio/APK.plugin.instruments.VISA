  "transport": {
    "_note": "Protocol constants, not a per-model interface inventory. Which of these a box actually answers on is measured by the discovery sweep and recorded in the family probe file.",
    "default": "raw_socket",
    "visa": {
      "lan": "TCPIP0::<host>::inst0::INSTR",
      "raw": "TCPIP0::<host>::5025::SOCKET",
      "hislip": "TCPIP0::<host>::hislip0::INSTR",
      "gpib": "GPIB0::<address>::INSTR",
      "usb": "USB0::<vid>::<pid>::<serial>::INSTR",
      "serial": "ASRL<n>::INSTR"
    },
    "sockets": {
      "raw_socket": {
        "port": 5025,
        "kind": "tcp",
        "write_terminator": "\n",
        "read_terminator": "\n",
        "description": "Bare SCPI over TCP. No session layer, no discovery."
      },
      "hislip": {
        "port": 4880,
        "kind": "tcp",
        "description": "IVI HiSLIP. Carries SRQ and device clear, unlike the raw socket."
      },
      "vxi11": {
        "port": 111,
        "kind": "tcp",
        "description": "SUNRPC portmapper only; the core channel port is negotiated per session."
      },
      "telnet": {
        "port": 5024,
        "kind": "tcp",
        "description": "Human-facing SCPI prompt. Echoes and prints a banner \u2014 do not parse."
      }
    }
  },
