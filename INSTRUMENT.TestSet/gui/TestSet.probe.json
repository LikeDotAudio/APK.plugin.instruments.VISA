{
  "TestSet": {
    "type": "OcaBin",
    "description": {
      "En": "Capture points on discovered Test Set devices"
    },
    "behavior": {
      "overflow_ns": "auto"
    },
    "blocks": {
      "Sweep": {
        "type": "OcaBlock",
        "label": {
          "active": {
            "text": {
              "En": "Discovery Sweep"
            }
          }
        },
        "fields": {
          "sweep": {
            "type": "_GuiSweepStatus",
            "description": {
              "En": "Discovery Sweep"
            },
            "topic": "APK.audio/System/CapturePoints/Sweep",
            "endpoint": "/api/discovery/sweep",
            "layout": {
              "height": 96,
              "width": "100%"
            }
          }
        }
      },
      "Points": {
        "type": "OcaTable",
        "description": {
          "En": "Capture points for Test Sets"
        },
        "topic": "APK.audio/Gui/CapturePoints/TestSet",
        "headers": [
          "point",
          "device",
          "family",
          "side",
          "domain",
          "signal",
          "position",
          "terminal",
          "status",
          "verdict",
          "checked",
          "last_seen",
          "topic"
        ],
        "data": []
      }
    }
  }
}
